{
  "ai": {
    "provider": "openai",
    "model": "Qwen/Qwen3-8B",
    "base_url": "https://api.siliconflow.cn/v1",
    "api_key_env": "SILICONFLOW_API_KEY",
    "extra_body": {
      "enable_thinking": false
    },
    "temperature": 0.2,
    "max_tokens": 4096,
    "throttle_sec": 4,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "languages": ["zh"]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 8.0,
        "topic_dedup": true
      },
      "finance-news": {
        "threshold": 8.0,
        "topic_dedup": true
      }
    }
  },
  "email": {
    "enabled": true,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "${HORIZON_EMAIL}",
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "torvalds",
        "enabled": false,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "astral-sh",
        "repo": "uv",
        "enabled": false,
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 100,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-news"
      },
      {
        "name": "arXiv Multi-Agent Systems",
        "url": "https://rss.arxiv.org/rss/cs.MA",
        "enabled": true,
        "category": "agent-research",
        "profile": "tech-news"
      },
      {
        "name": "机器之心",
        "url": "https://www.jiqizhixin.com/rss",
        "enabled": true,
        "category": "ai-industry",
        "profile": "tech-news"
      },
      {
        "name": "量子位",
        "url": "https://www.qbitai.com/feed",
        "enabled": true,
        "category": "ai-industry",
        "profile": "tech-news"
      },
      {
        "name": "InfoQ 中国",
        "url": "https://www.infoq.cn/feed?token=${INFOQ_TOKEN}&utm_source=feed",
        "enabled": true,
        "category": "ai-tech",
        "profile": "tech-news"
      },
      {
        "name": "ServeTheHome",
        "url": "https://www.servethehome.com/feed/",
        "enabled": true,
        "category": "hardware",
        "profile": "tech-news"
      },
      {
        "name": "Tom's Hardware",
        "url": "https://www.tomshardware.com/feeds/all",
        "enabled": true,
        "category": "hardware",
        "profile": "tech-news"
      },
      {
        "name": "LWN.net (subscriber full-text)",
        "url": "https://lwn.net/headlines/full_text?key=${LWN_KEY}",
        "enabled": false,
        "category": "linux",
        "profile": "tech-news"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 50,
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 30,
          "profile": "tech-news"
        },
        {
          "subreddit": "singularity",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 50,
          "profile": "tech-news"
        }
      ],
      "users": [
        {
          "username": "iamthatis",
          "enabled": true,
          "sort": "new",
          "fetch_limit": 10,
          "profile": "tech-news"
        }
      ],
      "fetch_comments": 5
    },
    "twitter": {
      "enabled": false,
      "users": ["karpathy", "ylecun"],
      "fetch_limit": 10,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 5,
      "profile": "tech-news"
    },
    "openbb": {
      "enabled": true,
      "fetch_filings": false,
      "filings_provider": "sec",
      "watchlists": [
        {
          "name": "megacaps",
          "enabled": true,
          "provider": "yfinance",
          "fetch_limit": 20,
          "category": "equities",
          "symbols": ["AAPL", "MSFT", "NVDA", "GOOGL", "AMZN", "META", "TSLA"],
          "profile": "finance-news"
        },
        {
          "name": "semiconductors",
          "enabled": true,
          "provider": "yfinance",
          "fetch_limit": 20,
          "category": "semiconductors",
          "symbols": ["AMD", "INTC", "ASML", "TSM", "MU", "AVGO", "QCOM", "AMAT", "LRCX", "ARM"],
          "profile": "finance-news"
        }
      ]
    },
    "ossinsight": {
      "enabled": false,
      "period": "past_24_hours",
      "languages": ["All", "Python", "TypeScript"],
      "keywords": [],
      "min_stars": 10,
      "max_items": 30,
      "profile": "tech-news"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 40,
    "profile_order": ["tech-news", "finance-news"],
    "category_groups": {
      "research": {
        "limit": 10,
        "categories": ["agent-research"]
      },
      "ai-industry": {
        "limit": 10,
        "categories": ["ai-industry", "ai-tech", "ai-tools"]
      },
      "hardware": {
        "limit": 5,
        "categories": ["hardware"]
      }
    },
    "default_group": "other",
    "default_group_limit": 10
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": null,
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "Horizon生成结果: #{result}\nHorizon日报重要资讯数量: #{important_items}/#{all_items}"
            },
            {
              "tag": "hr"
            },
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
